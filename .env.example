HUBOT_SLACK_APP_TOKEN=xapp-replace-me
HUBOT_SLACK_BOT_TOKEN=xoxb-replace-me
FIREBASE_WEB_CONFIG='{"apiKey":"replace-me","projectId":"replace-me","appId":"replace-me"}'
# Local-only: use the in-memory notification cache when no Firestore emulator is running.
NOTIFICATION_STORE=memory
# Heroku: omit NOTIFICATION_STORE and configure a dedicated Firestore service account.
# FIREBASE_SERVICE_ACCOUNT=
ORGANIZER_BY_GROUP='{"catech":"U0123456789"}'
ORGANIZER_FIRST_NAME_BY_GROUP='{"catech":"Alex"}'
WELCOMER_BY_CHANNEL='{"C0123456789":"U0123456789"}'
EVENT_ANNOUNCEMENT_CHANNEL_ID=C0123456789
EVENT_GROUP_CHANNEL_IDS='{"catech":"C0123456789"}'
# Optional policy link and contacts for `slackbot code of conduct`.
# SLACKBOT_CODE_OF_CONDUCT_URL=https://www.lansing.codes/code-of-conduct/
# SLACKBOT_MODERATORS=U0123456789,U9876543210
# APPROVED_TWEETER_IDS=U0123456789,U9876543210
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
# X developer app and user write credentials for optional real posting:
# TWITTER_CONSUMER_KEY=
# TWITTER_CONSUMER_SECRET=
# TWITTER_ACCESS_TOKEN=
# TWITTER_ACCESS_TOKEN_SECRET=
